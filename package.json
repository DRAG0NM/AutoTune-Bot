{
  "name": "autotune-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AGNES PID AI tuning assistant for second-order inverted-pendulum simulation with CSV, SVG and HTML reports",
  "engines": {
    "node": ">=24.10"
  },
  "bin": {
    "autotune": "./bridge/cli.js"
  },
  "scripts": {
    "selftest": "node bridge/cli.js selftest",
    "test": "node --test",
    "trial:sim": "node bridge/cli.js trial --backend sim --json",
    "trial:replay": "node bridge/cli.js trial --backend replay --csv testdata/sample_step_response.csv --json",
    "plot:evidence": "node tools/plot-evidence.js",
    "verify:evidence": "node tools/verify-evidence-figures.js",
    "verify:history": "node tools/verify-history.js",
    "audit:sessions": "node tools/audit-sessions.js",
    "verify:submission": "node tools/verify-submission.js",
    "demo": "node tools/demo.js"
  },
  "dependencies": {},
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DRAG0NM/AutoTune-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/DRAG0NM/AutoTune-Bot/issues"
  },
  "homepage": "https://github.com/DRAG0NM/AutoTune-Bot#readme"
}
